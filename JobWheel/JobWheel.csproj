<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.1.0.0</Version>
    <Author>Ivory Frog</Author>
    <Name>Job Wheel</Name>
    <Punchline>Spin a wheel, play the job it picks.</Punchline>
    <Description>Spin a wheel of jobs. The wheel picks one, switches you to its gearset, and removes it from the wheel once you finish a duty on it.</Description>
    <RepoUrl>https://github.com/AJdisco/FFXIV-Plugins</RepoUrl>
    <Tags>AI;plugin;Jobs;Challenge</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
    <ItemGroup>
        <!-- Dalamud looks for images/icon.png next to the DLL, so the Link sets that output path. -->
        <Content Include="..\Images\JobWheelIcon.png">
            <Link>images\JobWheelIcon.png</Link>
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Visible>false</Visible>
        </Content>
    </ItemGroup>
</Project>
