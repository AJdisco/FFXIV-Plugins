<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.0.0.1</Version>
    <!-- Manifest fields (see https://github.com/goatcorp/DalamudPackager/blob/827d88dc/DalamudPackager/DalamudPackager.cs#L420) -->
    <Author>Ivory Frog</Author>
    <Name>Sub Profits</Name>
    <Punchline>I was lazy to track my Sub profits</Punchline>
    <Description>Tracks how much your selected items are worth to a vendor, adds it to your gil balance, and shows submarine return timers. Almost fully AI generated. I was just lazy.</Description>
    <RepoUrl>https://github.com/AJdisco/FFXIV-Plugins</RepoUrl>
    <Tags>AI;plugin;Gil;Submarines</Tags>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dalamud looks for images/icon.png next to the DLL, so the Link sets that output path. -->
    <Content Include="..\Images\SubProfitsIcon.png">
      <Link>images\icon.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
